[
  {
    "id": 1,
    "jozz": 1,
    "page": 1,
    "sura_no": 1,
    "sura_name_en": "Al-Fātiḥah",
    "sura_name_ar": "الفَاتِحة",
    "line_start": 2,
    "line_end": 2,
    "aya_no": 1,
    "aya_text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ﰀ",
    "aya_text_emlaey": "بسم الله الرحمن الرحيم"
  },
  {
    "id": 2,
    "jozz": 1,
    "page": 1,
    "sura_no": 1,
    "sura_name_en": "Al-Fātiḥah",
    "sura_name_ar": "الفَاتِحة",
    "line_start": 3,
    "line_end": 3,
    "aya_no": 2,
    "aya_text": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ ﰁ",
    "aya_text_emlaey": "الحمد لله رب العالمين"
  },
  {
    "id": 3,
    "jozz": 1,
    "page": 1,
    "sura_no": 1,
    "sura_name_en": "Al-Fātiḥah",
    "sura_name_ar": "الفَاتِحة",
    "line_start": 4,
    "line_end": 4,
    "aya_no": 3,
    "aya_text": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ﰂ",
    "aya_text_emlaey": "الرحمن الرحيم"
  },
  {
    "id": 4,
    "jozz": 1,
    "page": 1,
    "sura_no": 1,
    "sura_name_en": "Al-Fātiḥah",
    "sura_name_ar": "الفَاتِحة",
    "line_start": 4,
    "line_end": 4,
    "aya_no": 4,
    "aya_text": "مَٰلِكِ يَوۡمِ ٱلدِّينِ ﰃ",
    "aya_text_emlaey": "مالك يوم الدين"
  },
  {
    "id": 5,
    "jozz": 1,
    "page": 1,
    "sura_no": 1,
    "sura_name_en": "Al-Fātiḥah",
    "sura_name_ar": "الفَاتِحة",
    "line_start": 5,
    "line_end": 5,
    "aya_no": 5,
    "aya_text": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ ﰄ",
    "aya_text_emlaey": "إياك نعبد وإياك نستعين"
  },
  {
    "id": 6,
    "jozz": 1,
    "page": 1,
    "sura_no": 1,
    "sura_name_en": "Al-Fātiḥah",
    "sura_name_ar": "الفَاتِحة",
    "line_start": 5,
    "line_end": 6,
    "aya_no": 6,
    "aya_text": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ ﰅ",
    "aya_text_emlaey": "اهدنا الصراط المستقيم"
  },
  {
    "id": 7,
    "jozz": 1,
    "page": 1,
    "sura_no": 1,
    "sura_name_en": "Al-Fātiḥah",
    "sura_name_ar": "الفَاتِحة",
    "line_start": 6,
    "line_end": 8,
    "aya_no": 7,
    "aya_text": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ ﰆ",
    "aya_text_emlaey": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
  },
  {
    "id": 8,
    "jozz": 1,
    "page": 2,
    "sura_no": 2,
    "sura_name_en": "Al-Baqarah",
    "sura_name_ar": "البَقَرَة",
    "line_start": 3,
    "line_end": 3,
    "aya_no": 1,
    "aya_text": "الٓمٓ ﰀ",
    "aya_text_emlaey": "الم"
  },
  {
    "id": 9,
    "jozz": 1,
    "page": 2,
    "sura_no": 2,
    "sura_name_en": "Al-Baqarah",
    "sura_name_ar": "البَقَرَة",
    "line_start": 3,
    "line_end": 4,
    "aya_no": 2,
    "aya_text": "ذَٰلِكَ ٱلۡكِتَٰبُ لَا رَيۡبَۛ فِيهِۛ هُدٗى لِّلۡمُتَّقِينَ ﰁ",
    "aya_text_emlaey": "ذلك الكتاب لا ريب فيه هدى للمتقين"
  },
  {
    "id": 11,
    "jozz": 1,
    "page": 2,
    "sura_no": 2,
    "sura_name_en": "Al-Baqarah",
    "sura_name_ar": "البَقَرَة",
    "line_start": 5,
    "line_end": 6,
    "aya_no": 4,
    "aya_text": "وَٱلَّذِينَ يُؤۡمِنُونَ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَ وَبِٱلۡأٓخِرَةِ هُمۡ يُوقِنُونَ ﰃ",
    "aya_text_emlaey": "والذين يؤمنون بما أنزل إليك وما أنزل من قبلك وبالآخرة هم يوقنون"
  },
  {
    "id": 188,
    "jozz": 2,
    "page": 27,
    "sura_no": 2,
    "sura_name_en": "Al-Baqarah",
    "sura_name_ar": "البَقَرَة",
    "line_start": 14,
    "line_end": 15,
    "aya_no": 181,
    "aya_text": "فَمَنۢ بَدَّلَهُۥ بَعۡدَ مَا سَمِعَهُۥ فَإِنَّمَآ إِثۡمُهُۥ عَلَى ٱلَّذِينَ يُبَدِّلُونَهُۥٓۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ ﲴ",
    "aya_text_emlaey": "فمن بدله بعد ما سمعه فإنما إثمه على الذين يبدلونه إن الله سميع عليم"
  },
  {
    "id": 1236,
    "jozz": 10,
    "page": 187,
    "sura_no": 9,
    "sura_name_en": "At-Taubah",
    "sura_name_ar": "التوبَة",
    "line_start": 2,
    "line_end": 2,
    "aya_no": 1,
    "aya_text": "بَرَآءَةٞ مِّنَ ٱللَّهِ وَرَسُولِهِۦٓ إِلَى ٱلَّذِينَ عَٰهَدتُّم مِّنَ ٱلۡمُشۡرِكِينَ ﰀ",
    "aya_text_emlaey": "براءة من الله ورسوله إلى الذين عاهدتم من المشركين"
  },
  {
    "id": 1809,
    "jozz": 14,
    "page": 262,
    "sura_no": 15,
    "sura_name_en": "Al-Ḥijr",
    "sura_name_ar": "الحِجر",
    "line_start": 8,
    "line_end": 9,
    "aya_no": 7,
    "aya_text": "لَّوۡمَا تَأۡتِينَا بِٱلۡمَلَٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ﰆ",
    "aya_text_emlaey": "لو ما تأتينا بالملائكة إن كنت من الصادقين"
  },
  {
    "id": 5394,
    "jozz": 29,
    "page": 569,
    "sura_no": 70,
    "sura_name_en": "Al-Ma‘ārij",
    "sura_name_ar": "المَعَارج",
    "line_start": 4,
    "line_end": 4,
    "aya_no": 19,
    "aya_text": "۞ إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا ﰒ",
    "aya_text_emlaey": "إن الإنسان خلق هلوعا"
  }
]
